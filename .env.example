# Copy this file to .env for local development WITHOUT Docker.
# When using Docker (setup-federation.bat / setup-federation.sh) these values
# are supplied automatically by docker-compose.federation.yml — no .env needed.

# ── Database ──────────────────────────────────────────────────────────────────
# For Docker the compose file injects these automatically.
# For local `go run ./cmd/identity/` or `go run ./cmd/federation/`, set here.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fedinet_server_a?sslmode=disable

# ── Identity server ───────────────────────────────────────────────────────────
SERVER_ID=server_a
SERVER_NAME=Server A

# Public-facing base URL (used in tokens, invite QR codes, etc.)
SERVER_URL=http://localhost:8080

# Internal Docker-network URL used for inter-container requests.
# When running locally outside Docker this can be left equal to SERVER_URL.
SERVER_ENDPOINT=http://localhost:8080

# Ed25519 private key (hex-encoded, 64 bytes / 128 hex chars).
# Generate a new one with: go run ./cmd/signtest/
# NOTE: keep this secret — never commit the real value.
SERVER_IDENTITY_PRIVATE_KEY=<your-64-byte-ed25519-private-key-hex>

# JWT signing secret
JWT_SECRET=change-me-in-production

# ── Built-in admin account (only used during /initialize) ─────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password123

# ── Federation ────────────────────────────────────────────────────────────────
# Comma-separated list of peer servers: "id=http://host:port"
FEDERATION_PEERS=server_b=http://localhost:9080
