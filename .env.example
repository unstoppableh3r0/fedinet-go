# Federated Network Identity Service - Environment Configuration

# =============================================================================
# SMTP Configuration (Required for OTP Email Sending)
# =============================================================================
# OTP authentication requires a working SMTP server to send verification codes.
# Without proper SMTP configuration, registration and login will fail.

# SMTP Server Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# SMTP Authentication
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Sender Email (optional - defaults to SMTP_USERNAME if not set)
SMTP_FROM_EMAIL=noreply@yourserver.com

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fedinet_timeline

# =============================================================================
# Server Configuration
# =============================================================================
# Internal server name (used for user IDs like username@servername)
INTERNAL_SERVER_NAME=localhost

# JWT Secret (generate a random secure string)
JWT_SECRET=your-secret-key-here-change-this

# =============================================================================
# SMTP Setup Instructions
# =============================================================================
#
# For Gmail:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Generate an App Password: https://myaccount.google.com/apppasswords
# 3. Use the app password as SMTP_PASSWORD (not your regular password)
#
# For Mailgun:
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@your-domain.mailgun.org
# SMTP_PASSWORD=your-mailgun-smtp-password
#
# For SendGrid:
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-sendgrid-api-key
#
# For AWS SES:
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USERNAME=your-ses-smtp-username
# SMTP_PASSWORD=your-ses-smtp-password
